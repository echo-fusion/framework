APP_NAME="EchoFusion Blog"
# production, development, testing ... picks config/environments/<APP_ENV>.php
APP_ENV=development
# true shows error details in the browser. Keep it false in production.
APP_DEBUG=true
APP_TIMEZONE=UTC

# Session cookie: set SESSION_SECURE=true when the site is served over HTTPS
SESSION_SECURE=false

# Database (nothing connects until the first query). Drivers: mysql, pgsql, sqlite
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/database.sqlite
DB_USERNAME=
DB_PASSWORD=
